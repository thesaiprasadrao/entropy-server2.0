# ── Database Credentials ───────────────────────────────────────────────────────
# Use a long random password in production.
# Generate: openssl rand -hex 32
POSTGRES_USER=ctf_user
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=ctf_db

# ── Backend Database URL (must match the credentials above) ───────────────────
DATABASE_URL=postgresql://ctf_user:CHANGE_ME_use_openssl_rand_hex_32@db/ctf_db

# ── LLM Configuration ─────────────────────────────────────────────────────────
# JSON array of one or more Groq API keys.
# Multiple keys enable round-robin rotation across requests.
# Get keys at: https://console.groq.com/keys
LLM_API_KEYS=["gsk_REPLACE_WITH_REAL_KEY"]

# ── Admin Panel Security ───────────────────────────────────────────────────────
# Required — server will refuse to start if this is missing.
# Generate: openssl rand -hex 128
ADMIN_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_128

# ── Access Control ─────────────────────────────────────────────────────────────
# true  = auto-create any CTFd-authenticated user in the backend DB (open mode)
# false = only teams pre-seeded via seed_teams.py can play (locked-down event mode)
# NOTE: this only affects backend DB creation. CTFd registration must also be
#       closed (via CTFd admin panel) to prevent outsiders from signing up.
ALLOW_UNKNOWN_TEAMS=true

# ── CTFd ──────────────────────────────────────────────────────────────────────
# Long random secret for CTFd session signing.
# Generate: openssl rand -hex 32
CTFD_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# CTFd admin account — created automatically on first boot.
# Change these before going live.
CTFD_ADMIN_EMAIL=admin@example.com
CTFD_ADMIN_PASSWORD=CHANGE_ME_strong_password
